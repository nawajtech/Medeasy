# Copy to .env for local development only:
#   cp .env.example .env
#
# Never commit .env with production secrets mixed with localhost URLs.
# For production builds use .env.production (from .env.production.example).

# Local backend (php artisan serve)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Center chat Socket.IO (run: cd realtime && npm start)
VITE_CENTER_CHAT_SOCKET_URL=http://127.0.0.1:3001

# Force partner portal UI locally (omit on live — hostname selects the app)
# VITE_APP_MODE=partner
