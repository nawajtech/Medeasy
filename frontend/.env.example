# Copy to .env for local development:
#   cp .env.example .env
#
# For production build, copy .env.production.example to .env.production
# and set your live API URL BEFORE running: npm run build

# Local backend (php artisan serve)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Center chat Socket.IO (run: cd realtime && npm start)
VITE_CENTER_CHAT_SOCKET_URL=http://127.0.0.1:3001

# Patient portal local mode (serves patient.apnamedi.com UI on this Vite app)
# VITE_APP_MODE=patient
