# Copy to .env.production before building for live server:
#   cp .env.production.example .env.production
#
# Then edit VITE_API_BASE_URL to your live backend URL and run:
#   npm run build
#
# Examples:
#   Same server (frontend + API on one domain):  https://yourdomain.com/api
#   Separate API subdomain:                    https://api.yourdomain.com/api
#
# Staff app (app.apnamedi.com):
#   VITE_API_BASE_URL=https://app.apnamedi.com/api
#
# Patient portal (patient.apnamedi.com) — same API host; hostname auto-selects patient UI:
#   VITE_API_BASE_URL=https://app.apnamedi.com/api
#   (optional local force) VITE_APP_MODE=patient

VITE_API_BASE_URL=https://app.apnamedi.com/api
