# Copy to .env.production before building for live server:
#   cp .env.production.example .env.production
#
# Then run: npm run build
#
# Do NOT put localhost / 127.0.0.1 here — those values get baked into the JS bundle.

VITE_API_BASE_URL=https://app.apnamedi.com/api

# Optional — center chat Socket.IO (leave empty to disable realtime chat)
# VITE_CENTER_CHAT_SOCKET_URL=https://app.apnamedi.com

# Do NOT set VITE_APP_MODE on live — hostname picks the app:
#   app.apnamedi.com      → staff
#   partner.apnamedi.com  → partner portal
#   patient.apnamedi.com  → partner portal (legacy host)
